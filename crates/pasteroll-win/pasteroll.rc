1 ICON "pasteroll.ico"

1 VERSIONINFO
FILEVERSION APP_FILE_VERSION
PRODUCTVERSION APP_FILE_VERSION
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", APP_PUBLISHER
            VALUE "FileDescription", "Pasteroll clipboard history"
            VALUE "FileVersion", APP_VERSION
            VALUE "InternalName", "pasteroll"
            VALUE "LegalCopyright", APP_LICENSE
            VALUE "OriginalFilename", "pasteroll.exe"
            VALUE "ProductName", "Pasteroll"
            VALUE "ProductVersion", APP_VERSION
            VALUE "Comments", APP_URL
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
